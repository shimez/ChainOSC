{
  "format": "ChainOSC-encoder-v2-runtime-vectors",
  "version": 1,
  "numericTolerance": 0.000001,
  "cases": [
    {
      "id": "AMOUNT-RESET-NO-SEND",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":true,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":13},
      "events": [{"operation":"applyPreset"},{"delta":1}],
      "expected": [{"send":false},{"logicalPosition":1,"send":true,"value":0.05}]
    },
    {
      "id": "AMOUNT-WRAP-INCLUDES-BOTH-ENDS",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":true,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":19},
      "events": [{"delta":1},{"delta":1},{"delta":-1},{"delta":5}],
      "expected": [
        {"logicalPosition":20,"send":true,"value":1.0},
        {"logicalPosition":0,"send":true,"value":0.0},
        {"logicalPosition":20,"send":true,"value":1.0},
        {"logicalPosition":4,"send":true,"value":0.2}
      ]
    },
    {
      "id": "AMOUNT-CLAMP-HAS-NO-HIDDEN-OVERSHOOT",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":19},
      "events": [{"delta":5},{"delta":-1},{"delta":-50},{"delta":1}],
      "expected": [
        {"logicalPosition":20,"send":true,"value":1.0},
        {"logicalPosition":19,"send":true,"value":0.95},
        {"logicalPosition":0,"send":true,"value":0.0},
        {"logicalPosition":1,"send":true,"value":0.05}
      ]
    },
    {
      "id": "AMOUNT-COUNTER-CLOCKWISE-INCREASES",
      "settings": {"rotationMode":"amount","clockwiseIncreases":false,"rangeSteps":4,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":2},
      "events": [{"delta":1},{"delta":-1},{"delta":-2}],
      "expected": [
        {"logicalPosition":1,"send":true,"value":0.25},
        {"logicalPosition":2,"send":true,"value":0.5},
        {"logicalPosition":4,"send":true,"value":1.0}
      ]
    },
    {
      "id": "AMOUNT-STOP-ENDPOINT-RESENDS",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":4,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":4},
      "events": [{"delta":1},{"delta":3}],
      "expected": [
        {"logicalPosition":4,"send":true,"value":1.0},
        {"logicalPosition":4,"send":true,"value":1.0}
      ]
    },
    {
      "id": "AMOUNT-STRING-FIXED-THREE-DECIMALS",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":4,"wrap":false,"outputMin":-0.0004,"outputMax":0.0004,"outputType":2},
      "initialState": {"logicalPosition":0},
      "events": [{"delta":1},{"delta":1},{"delta":2}],
      "expected": [
        {"logicalPosition":1,"send":true,"value":"0.000"},
        {"logicalPosition":2,"send":true,"value":"0.000"},
        {"logicalPosition":4,"send":true,"value":"0.000"}
      ]
    },
    {
      "id": "DIRECTION-USES-SIGN-ONCE",
      "settings": {"rotationMode":"direction","clockwiseValue":0.1,"counterClockwiseValue":-0.25,"outputType":0},
      "events": [{"delta":1},{"delta":5},{"delta":-1},{"delta":-7},{"delta":0}],
      "expected": [
        {"send":true,"value":0.1},
        {"send":true,"value":0.1},
        {"send":true,"value":-0.25},
        {"send":true,"value":-0.25},
        {"send":false}
      ]
    },
    {
      "id": "DIRECTION-STRING-VALUES-ARE-LITERAL",
      "settings": {"rotationMode":"direction","clockwiseValue":"next","counterClockwiseValue":"prev","outputType":2},
      "events": [{"delta":3},{"delta":-2}],
      "expected": [{"send":true,"value":"next"},{"send":true,"value":"prev"}]
    },
    {
      "id": "RECONNECT-BASELINE-PRESERVES-AMOUNT-POSITION",
      "identity": "00112233445566778899AABB",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":7,"rawBaseline":120,"baselineValid":true},
      "events": [
        {"operation":"continuityLost"},
        {"operation":"rawSample","raw":3},
        {"operation":"rawSample","raw":4}
      ],
      "expected": [
        {"logicalPosition":7,"baselineValid":false,"send":false},
        {"logicalPosition":7,"rawBaseline":3,"baselineValid":true,"send":false},
        {"logicalPosition":8,"rawBaseline":4,"baselineValid":true,"send":true,"value":0.4}
      ]
    },
    {
      "id": "DIFFERENT-UID-RESETS-AMOUNT-POSITION",
      "identity": "00112233445566778899AABB",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":7,"rawBaseline":120,"baselineValid":true},
      "events": [{"operation":"replaceIdentity","identity":"FFEEDDCCBBAA998877665544","raw":50}],
      "expected": [{"logicalPosition":0,"rawBaseline":50,"baselineValid":true,"send":false}]
    },
    {
      "id": "AMOUNT-INT-ROUNDS-HALF-AWAY-FROM-ZERO",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":3,"wrap":false,"outputMin":-1.5,"outputMax":1.5,"outputType":1},
      "initialState": {"logicalPosition":0},
      "events": [{"delta":1},{"delta":1},{"delta":1}],
      "expected": [
        {"logicalPosition":1,"send":true,"value":-1},
        {"logicalPosition":2,"send":true,"value":1},
        {"logicalPosition":3,"send":true,"value":2}
      ]
    },
    {
      "id": "AMOUNT-ACTIVE-SETTING-CHANGES-RESET",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0},
      "initialState": {"logicalPosition":7},
      "events": [
        {"operation":"updateSettings","changes":{"rangeSteps":21}},
        {"delta":1},
        {"operation":"updateSettings","changes":{"wrap":true}},
        {"delta":1},
        {"operation":"updateSettings","changes":{"clockwiseIncreases":false}},
        {"delta":-1},
        {"operation":"updateSettings","changes":{"outputMin":-1.0}},
        {"delta":-1},
        {"operation":"updateSettings","changes":{"outputMax":2.0}},
        {"delta":-1},
        {"operation":"updateSettings","changes":{"outputType":1}},
        {"delta":-1}
      ],
      "expected": [
        {"send":false},
        {"logicalPosition":1,"send":true},
        {"send":false},
        {"logicalPosition":1,"send":true},
        {"send":false},
        {"logicalPosition":1,"send":true},
        {"send":false},
        {"logicalPosition":1,"send":true},
        {"send":false},
        {"logicalPosition":1,"send":true},
        {"send":false},
        {"logicalPosition":1,"send":true,"value":-1}
      ]
    },
    {
      "id": "CHANGE-TO-AMOUNT-MODE-RESETS",
      "settings": {"rotationMode":"direction","clockwiseValue":1,"counterClockwiseValue":-1,"outputType":1},
      "initialState": {"logicalPosition":7},
      "events": [{"operation":"updateSettings","changes":{"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0}},{"delta":1}],
      "expected": [{"send":false},{"logicalPosition":1,"send":true,"value":0.05}]
    },
    {
      "id": "AMOUNT-INACTIVE-DIRECTION-SETTING-CHANGES-DO-NOT-RESET",
      "settings": {"rotationMode":"amount","clockwiseIncreases":true,"rangeSteps":20,"wrap":false,"outputMin":0.0,"outputMax":1.0,"outputType":0,"clockwiseValue":1,"counterClockwiseValue":-1},
      "initialState": {"logicalPosition":7},
      "events": [{"operation":"updateInactiveSettings","changes":{"clockwiseValue":10,"counterClockwiseValue":-5}},{"delta":1}],
      "expected": [{"send":false},{"logicalPosition":8,"send":true,"value":0.4}]
    }
  ]
}
